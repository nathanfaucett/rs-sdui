  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.js"
  },
  "peerDependencies": {
    "@a2ui/web_core": "0.16.1"
