{
  "name": "@sdui/web",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./shared-worker": {
      "types": "./dist/shared-worker-transport.d.ts",
      "import": "./dist/shared-worker-transport.js"
    },
    "./sse": {
      "types": "./dist/sse-transport.d.ts",
      "import": "./dist/sse-transport.js"
    },
    "./websocket": {
      "types": "./dist/websocket-transport.d.ts",
      "import": "./dist/websocket-transport.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
